{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ServiceName": "mvp-demo-service",
  "ServiceVersion": "1.0.0",
  "Otel": {
    "OtlpEndpoint": "http://localhost:4317",
    "OtlpHttpEndpoint": "http://localhost:4318",
    "EnableRedis": true,
    "EnableGrpc": false,
    "EnableMongo": true,
    "EnableMassTransit": false,
    "EnableQuartz": false
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379",
    "Mongo": "mongodb://localhost:27017"
  }
}
